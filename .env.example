# ---------------------------------------------------------------------------
# Liara AI - local development environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=liaraai
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=liaraai
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- ASP.NET Core connection strings ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=liaraai;Username=liaraai;Password=your-postgres-password
ConnectionStrings__Redis=localhost:6379

# --- AvalAI (LLM / embedding provider) ---
AvalAI__ApiKey=your-avalai-api-key-here
AvalAI__BaseUrl=https://api.avalai.ir
